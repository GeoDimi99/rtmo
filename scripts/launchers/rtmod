#!/usr/bin/env bash
# rtmod: written by install.sh from scripts/launchers/rtmod
#
# Runs the deploy-manager for one command: service 'deploy-manager' of
# device/compose.yaml (network, Docker socket, gRPC socket folder are set there).
# For 'apply', the manifest's folder is added, read-only, at the same path.
set -euo pipefail

RTMO_HOME="@RTMO_HOME@"
export RTMO_VERSION="$(cat "$RTMO_HOME/VERSION")"     # the image tag in compose.yaml

RTMO_INFRA_CPU=3
if [ -f /etc/rtmo/device.yaml ]; then
    v="$(sed -nE 's/^infra_cpu:[[:space:]]*([0-9]+).*/\1/p' /etc/rtmo/device.yaml | head -n1)"
    RTMO_INFRA_CPU="${v:-$RTMO_INFRA_CPU}"
fi
export RTMO_INFRA_CPU

args=("$@")
mounts=()
if [ "${1:-}" = "apply" ]; then
    # the first argument after 'apply' that is neither an option nor an option's value
    for ((i = 1; i < ${#args[@]}; i++)); do
        case "${args[$i]}" in
            --coordination|--technology|--iterations) i=$((i + 1)) ;;
            -*) ;;
            *)
                manifest="$(realpath -- "${args[$i]}")"
                [ -f "$manifest" ] || { echo "rtmod: manifest not found: ${args[$i]}" >&2; exit 1; }
                args[$i]="$manifest"
                mounts+=(-v "$(dirname "$manifest"):$(dirname "$manifest"):ro")
                break ;;
        esac
    done
fi

mkdir -p /tmp/rtmo-grpc-ipc        # created here so it belongs to the user, not to root
# -T: no terminal, so the output stays plain when piped (as with 'docker run' before).
# --no-deps: Redis is a service of its own, started by install.sh.
exec docker compose -f "$RTMO_HOME/device/compose.yaml" run --rm -T --no-deps \
    "${mounts[@]}" \
    deploy-manager "${args[@]}"
